{
  "name": "fashion-floor-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:validate": "prisma validate",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "seed:catalog": "npm run build && node dist/seed-catalog.js",
    "db:check": "npm run build && node dist/health-check.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "^5.9.3"
  }
}
